const imgBg = new Image();     imgBg.src = 'Gemini_Generated_Image_kGemini_Generated_Image_yh8jd8yh8jd8yh8j.pngwnjagkwnjagkwnj.png';
const imgPlayer = new Image(); imgPlayer.src = 'Gemini_Generated_Image_yqvlqeyqvlqeyqvl.png';
const imgPlatform = new Image(); imgPlatform.src = 'Gemini_Generated_Image_9wx5gr9wx5gr9wx5.png';
const imgAbyss = new Image();    imgAbyss.src = 'Gemini_Generated_Image_yh8jd8yh8jd8yh8j.png';
const imgGoalStar = new Image();    imgGoalStar.src = 'Gemini_Generated_Image_fjn93ufjn93ufjn9.png';

imgBg.onload = () => imagesLoaded.bg = true;
imgPlayer.onload = () => imagesLoaded.player = true;
imgPlatform.onload = () => imagesLoaded.platform = true;
