imgGoalStar.onload = () => imagesLoaded.goal = true;
// --- 2. ゲームのデータ設定 ---
let player = { 
    x: 0, y: 0, w: 200, h: 200, // うさぎのサイズ
    dy: 0, jump: -12, speed: 4, onGround: false 
};
let gravity = 0.6;
let scrollX = 0;
let score = 0;
let lives = 5;
let isGameClear = false;

// さっき抜き出した「足場画像（platforms.png）」から、どの部分を切り取ってどこに配置するかを指定します
// sx, sy, sw, sh = 画像の中の切り取り位置とサイズ / x, y, w, h = ゲーム画面内での配置位置とサイズ
let mapObjects = [
    // スタート地点の雲の足場
    { sx: 15, sy: 720, sw: 180, sh: 100, x: 0, y: 320, w: 180, h: 80 },
    // 途中の浮いている雲
    { sx: 10, sy: 260, sw: 190, sh: 120, x: 240, y: 240, w: 150, h: 90 },
    // 結晶のついた雲
    { sx: 820, sy: 260, sw: 180, sh: 180, x: 460, y: 160, w: 150, h: 150 },
    // 小さなピンクの雲
    { sx: 660, sy: 300, sw: 140, sh: 80,  x: 680, y: 260, w: 100, h: 60 },
    // ゴール地点の大きな星つきの雲
    { sx: 720, sy: 700, sw: 280, sh: 140, x: 880, y: 280, w: 250, h: 120 }
];
  
// --- ⭐ 星（ゴール）の配置データ ---
// 一番右の足場（x: 880）の上に、50×50マスの大きさで設置します
let goal = { x: 980, y: 220, w: 50, h: 50 };

let keys = {};

// --- 3. キーボード操作 ---
window.addEventListener('keydown', e => { keys[e.code] = true; });
window.addEventListener('keyup', e => { keys[e.code] = false; });
canvas.addEventListener('click', () => { canvas.focus(); });

// --- 4. ゲームのメイン処理 ---
function gameLoop() {
    // クリア状態なら動かさない
    update();
    draw();
    requestAnimationFrame(gameLoop);
}
function update() {
    if (isGameClear) return;
    
    // 左右移動・ジャンプ
    if (keys['ArrowRight']) player.x += player.speed;
    if (keys['ArrowLeft']) player.x -= player.speed;
    if (keys['Space'] && player.onGround) {
        player.dy = player.jump;
        player.onGround = false;
    }

    player.dy += gravity;
    player.y += player.dy;
    player.onGround = false;

    // 足場との衝突判定
    mapObjects.forEach(obj => {
        if (player.x < obj.x + obj.w && player.x + player.w > obj.x &&
            player.y + player.h > obj.y && player.y + player.h < obj.y + obj.h + player.dy) {
            player.y = obj.y - player.h;
            player.dy = 0;
            player.onGround = true;
        }
    });

    // カメラのスクロール
    if (player.x > canvas.width / 3) {
        scrollX = player.x - canvas.width / 3;
    }

    // 奈落判定
    if (player.y > canvas.height) {
        lives--;
        if (lives <= 0) {
            alert("ゲームオーバー！");
            score = 0;
            lives = 5;
        }
        resetGame();
    }

    // --- 🎯 星とのあたり判定（ここが重要！） ---
    if (player.x < goal.x + goal.w && player.x + player.w > goal.x &&
        player.y < goal.y + goal.h && player.y + player.h > goal.y) {
        isGameClear = true; // クリア状態にする
        score += 500;
    }
}
// --- 5. 画面の描画処理 ---
function draw() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);

    // ① 背景の描画（画像がなければピンク色のグラデーション）
    if (imagesLoaded.bg) {
        let bgX = -(scrollX * 0.3) % canvas.width; 
        ctx.drawImage(imgBg, bgX, 0, canvas.width, canvas.height);
        ctx.drawImage(imgBg, bgX + canvas.width, 0, canvas.width, canvas.height);
    } else {
        ctx.fillStyle = "#fff0f5";
        ctx.fillRect(0, 0, canvas.width, canvas.height);
    }

    ctx.save();
    ctx.translate(-scrollX, 0);

    mapObjects.forEach(obj => {
        if (imagesLoaded.platform) {
            ctx.drawImage(imgPlatform, obj.sx, obj.sy, obj.sw, obj.sh, obj.x, obj.y, obj.w, obj.h);
        } else {
            ctx.fillStyle = "#afeeee";
            ctx.fillRect(obj.x, obj.y, obj.w, obj.h);
        }
    });

    if (imagesLoaded.goal) {
        ctx.drawImage(imgGoalStar, goal.x, goal.y, goal.w, goal.h);
    } else {
        ctx.fillStyle = "#ffd700";
        ctx.beginPath();
        ctx.arc(goal.x + goal.w/2, goal.y + goal.h/2, goal.w/2, 0, Math.PI * 2);
        ctx.fill();
    }

    // ① 背景
    let bgX = -(scrollX * 0.3) % canvas.width; 
    ctx.drawImage(imgBg, bgX, 0, canvas.width, canvas.height);
    ctx.drawImage(imgBg, bgX + canvas.width, 0, canvas.width, canvas.height);

    ctx.save();
    ctx.translate(-scrollX, 0);

    // ④ プレイヤーの描画（画像がなければ白い四角）
    if (imagesLoaded.player) {
        ctx.drawImage(imgPlayer, player.x, player.y, player.w, player.h);
    } else {
        ctx.fillStyle = "#ffffff";
        ctx.strokeStyle = "#ffb6c1";
        ctx.lineWidth = 3;
        ctx.fillRect(player.x, player.y, player.w, player.h);
        ctx.strokeRect(player.x, player.y, player.w, player.h);
    }

    ctx.restore();

    // ⑤ 奈落の描画（画像がなければ紺色の床）
    if (imagesLoaded.abyss) {
        ctx.drawImage(imgAbyss, 0, 320, canvas.width, 80);
    } else {
        ctx.fillStyle = "#191970";
        ctx.fillRect(0, 320, canvas.width, 80);
    }

    // ⑥ UI（文字）
    ctx.fillStyle = "#887a93";
    ctx.font = "bold 16px sans-serif";
    ctx.fillText(`SCORE: ${score}`, 20, 30);
    ctx.fillText(`LIVES: ${"❤️".repeat(lives)}`, 20, 55);

    // --- 🎉 ゲームクリア画面の表示 ---
    if (isGameClear) {
        // 半透明の可愛いピンクの膜を張る
        ctx.fillStyle = "rgba(255, 220, 235, 0.8)";
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        // クリア文字
        ctx.fillStyle = "#e096b7";
        ctx.font = "bold 40px sans-serif";
        ctx.textAlign = "center";
        ctx.fillText("CONGRATULATIONS!", canvas.width / 2, canvas.height / 2);
        
        ctx.font = "bold 20px sans-serif";
        ctx.fillText("⭐ ゲームクリア！おめでとう！ ⭐", canvas.width / 2, canvas.height / 2 + 50);
    }
}

function resetGame() {
    player.x = 60;
    player.y = 200;
